{
  "name": "builder-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts *.json *.ts *.md",
    "test": "node scripts/test.mjs",
    "test:e2e": "playwright test",
    "db": "node --env-file=.env scripts/supabase.mjs",
    "db:types": "node scripts/generate-db-types.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.106.1",
    "globals": "^17.14.0",
    "lucide-react": "1.69.0",
    "mobx": "7.1.4",
    "mobx-persist": "0.4.1",
    "mobx-react-lite": "5.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  },
  "packageManager": "yarn@4.12.0",
  "resolutions": {
    "minimatch": "11.0.4"
  }
}
